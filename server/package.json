{
  "name": "tigerwage-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch src/index.ts",
    "reminders": "tsx src/jobs/run-reminders.ts",
    "build:lambda": "esbuild src/lambda.ts src/lambda-reminders.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --minify --external:@aws-sdk/* --outdir=dist",
    "package:lambda": "npm run build:lambda && powershell -NoProfile -Command \"Copy-Item global-bundle.pem dist/ -Force; Compress-Archive -Path dist/* -DestinationPath lambda.zip -Force\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
